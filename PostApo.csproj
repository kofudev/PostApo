<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>PostApo</AssemblyName>
    <RootNamespace>PostApo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Description>Plugin serveur Nova-Life: Amboise — RP post-apocalyptique (arrivee, districts, etabli, farm, craft).</Description>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Le plugin est standalone : rien d'autre que PostApo.dll ne doit etre copie. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Un second exemplaire complet du projet existe sous PostApo\PostApo\ (avec son propre depot
       git). Le SDK compile tous les .cs du dossier : sans cette exclusion, chaque type est defini
       deux fois et la compilation echoue. On exclut au lieu de supprimer : c'est a l'auteur de
       decider quelle copie fait foi. -->
  <ItemGroup>
    <Compile Remove="PostApo\**" />
    <None Remove="PostApo\**" />
    <EmbeddedResource Remove="PostApo\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Toutes les references pointent vers les assemblies du serveur : Private=false,
       aucune DLL tierce n'est deployee a cote du plugin. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\libs\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>..\libs\Mirror.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mirror.Components">
      <HintPath>..\libs\Mirror.Components.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\libs\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule">
      <HintPath>..\libs\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\libs\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Requis uniquement pour la resolution de surcharge de LifeServer.GetPlayer(SteamId) :
         le plugin n'utilise aucun type Steamworks directement. -->
    <Reference Include="Facepunch.Steamworks.Posix">
      <HintPath>..\libs\Facepunch.Steamworks.Posix.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" CopyToOutputDirectory="Always" />
    <None Include="SETUP.md" CopyToOutputDirectory="Always" />
  </ItemGroup>

</Project>
